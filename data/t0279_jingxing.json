   "section": "行腳",
   "cond": "手執錫杖",
   "vow": "設大施會，示如實道。"
  },
  {
   "n": 48,
   "text": "執持應器，當願眾生：成就法器，受天人供。",
   "line": "0070c08",
   "section": "行腳",
   "cond": "執持應器",
   "vow": "成就法器，受天人供。"
  },
  {
   "n": 49,
   "text": "發趾向道，當願眾生：趣佛所行，入無依處。",
   "line": "0070c10",
   "section": "行腳",
   "cond": "發趾向道",
   "vow": "趣佛所行，入無依處。"
  },
  {
   "n": 50,
   "text": "若在於道，當願眾生：能行佛道，向無餘法。",
   "line": "0070c11",
   "section": "行腳",
   "cond": "若在於道",
   "vow": "能行佛道，向無餘法。"
  },
  {
   "n": 51,
   "text": "涉路而去，當願眾生：履淨法界，心無障礙。",
   "line": "0070c12",
   "section": "行腳",
   "cond": "涉路而去",
   "vow": "履淨法界，心無障礙。"
  },
  {
   "n": 52,
   "text": "見昇高路，當願眾生：永出三界，心無怯弱。",
   "line": "0070c14",
   "section": "行腳",
   "cond": "見昇高路",
   "vow": "永出三界，心無怯弱。"
  },
  {
   "n": 53,
   "text": "見趣下路，當願眾生：其心謙下，長佛善根。",
   "line": "0070c15",
   "section": "行腳",
   "cond": "見趣下路",
   "vow": "其心謙下，長佛善根。"
  },
  {
   "n": 54,
   "text": "見斜曲路，當願眾生：捨不正道，永除惡見。",
   "line": "0070c16",
   "section": "行腳",
   "cond": "見斜曲路",
   "vow": "捨不正道，永除惡見。"
  },
  {
   "n": 55,
   "text": "若見直路，當願眾生：其心正直，無諂無誑。",
   "line": "0070c18",
   "section": "行腳",
   "cond": "若見直路",
   "vow": "其心正直，無諂無誑。"
  },
  {
   "n": 56,
   "text": "見路多塵，當願眾生：遠離塵坌，獲清淨法。",
   "line": "0070c19",
   "section": "行腳",
   "cond": "見路多塵",
   "vow": "遠離塵坌，獲清淨法。"
  },
  {
   "n": 57,
   "text": "見路無塵，當願眾生：常行大悲，其心潤澤。",
   "line": "0070c20",
   "section": "行腳",
   "cond": "見路無塵",
   "vow": "常行大悲，其心潤澤。"
  },
  {
   "n": 58,
   "text": "若見險道，當願眾生：住正法界，離諸罪難。",
   "line": "0070c22",
   "section": "行腳",
   "cond": "若見險道",
   "vow": "住正法界，離諸罪難。"
  },
  {
   "n": 59,
   "text": "若見眾會，當願眾生：說甚深法，一切和合。",
   "line": "0070c23",
   "section": "行腳",
   "cond": "若見眾會",
   "vow": "說甚深法，一切和合。"
  },
  {
   "n": 60,
   "text": "若見大柱，當願眾生：離我諍心，無有忿恨。",
   "line": "0070c24",
   "section": "行腳",
   "cond": "若見大柱",
   "vow": "離我諍心，無有忿恨。"
  },
  {
   "n": 61,
   "text": "若見叢林，當願眾生：諸天及人，所應敬禮。",
   "line": "0070c26",
   "section": "行腳",
   "cond": "若見叢林",
   "vow": "諸天及人，所應敬禮。"
  },
  {
   "n": 62,
   "text": "若見高山，當願眾生：善根超出，無能至頂。",
   "line": "0070c27",
   "section": "行腳",
   "cond": "若見高山",
   "vow": "善根超出，無能至頂。"
  },
  {
   "n": 63,
   "text": "見棘刺樹，當願眾生：疾得翦除，三毒之刺。",
   "line": "0070c28",
   "section": "行腳",
   "cond": "見棘刺樹",
   "vow": "疾得翦除，三毒之刺。"
  },
  {
   "n": 64,
   "text": "見樹葉茂，當願眾生：以定解脫，而為蔭映。",
   "line": "0071a01",
   "section": "行腳",
   "cond": "見樹葉茂",
   "vow": "以定解脫，而為蔭映。"
  },
  {
   "n": 65,
   "text": "若見華開，當願眾生：神通等法，如華開敷。",
   "line": "0071a02",
   "section": "行腳",
   "cond": "若見華開",
   "vow": "神通等法，如華開敷。"
  },
  {
   "n": 66,
   "text": "若見樹華，當願眾生：眾相如華，具三十二。",
   "line": "0071a03",
   "section": "行腳",
   "cond": "若見樹華",
   "vow": "眾相如華，具三十二。"
  },
  {
   "n": 67,
   "text": "若見果實，當願眾生：獲最勝法，證菩提道。",
   "line": "0071a05",
   "section": "行腳",
   "cond": "若見果實",
   "vow": "獲最勝法，證菩提道。"
  },
  {
   "n": 68,
   "text": "若見大河，當願眾生：得預法流，入佛智海。",
   "line": "0071a06",
   "section": "行腳",
   "cond": "若見大河",
   "vow": "得預法流，入佛智海。"
  },
  {
   "n": 69,
   "text": "若見陂澤，當願眾生：疾悟諸佛，一味之法。",
   "line": "0071a07",
   "section": "行腳",
   "cond": "若見陂澤",
   "vow": "疾悟諸佛，一味之法。"
  },
  {
   "n": 70,
   "text": "若見池沼，當願眾生：語業滿足，巧能演說。",
   "line": "0071a09",
   "section": "行腳",
   "cond": "若見池沼",
   "vow": "語業滿足，巧能演說。"
  },
  {
   "n": 71,
   "text": "若見汲井，當願眾生：具足辯才，演一切法。",
   "line": "0071a10",
   "section": "行腳",
   "cond": "若見汲井",
   "vow": "具足辯才，演一切法。"
  },
  {
   "n": 72,
   "text": "若見涌泉，當願眾生：方便增長，善根無盡。",
   "line": "0071a11",
   "section": "行腳",
   "cond": "若見涌泉",
   "vow": "方便增長，善根無盡。"
  },
  {
   "n": 73,
   "text": "若見橋道，當願眾生：廣度一切，猶如橋梁。",
   "line": "0071a13",
   "section": "行腳",
   "cond": "若見橋道",
   "vow": "廣度一切，猶如橋梁。"
  },
  {
   "n": 74,
   "text": "若見流水，當願眾生：得善意欲，洗除惑垢。",
   "line": "0071a14",
   "section": "行腳",
   "cond": "若見流水",
   "vow": "得善意欲，洗除惑垢。"
  },
  {
   "n": 75,
   "text": "見修園圃，當願眾生：五欲圃中，𦓷除愛草。",
   "line": "0071a15",
   "section": "行腳",
   "cond": "見修園圃",
   "vow": "五欲圃中，𦓷除愛草。"
  },
  {
   "n": 76,
   "text": "見無憂林，當願眾生：永離貪愛，不生憂怖。",
   "line": "0071a17",
   "section": "行腳",
   "cond": "見無憂林",
   "vow": "永離貪愛，不生憂怖。"
  },
  {
   "n": 77,
   "text": "若見園苑，當願眾生：勤修諸行，趣佛菩提。",
   "line": "0071a18",
   "section": "行腳",
   "cond": "若見園苑",
   "vow": "勤修諸行，趣佛菩提。"
  },
  {
   "n": 78,
   "text": "見嚴飾人，當願眾生：三十二相，以為嚴好。",
   "line": "0071a19",
   "section": "行腳",
   "cond": "見嚴飾人",
   "vow": "三十二相，以為嚴好。"
  },
  {
   "n": 79,
   "text": "見無嚴飾，當願眾生：捨諸飾好，具頭陀行。",
   "line": "0071a21",
   "section": "行腳",
   "cond": "見無嚴飾",
   "vow": "捨諸飾好，具頭陀行。"
  },
  {
   "n": 80,
   "text": "見樂著人，當願眾生：以法自娛，歡愛不捨。",
   "line": "0071a22",
   "section": "行腳",
   "cond": "見樂著人",
   "vow": "以法自娛，歡愛不捨。"
  },
  {
   "n": 81,
   "text": "見無樂著，當願眾生：有為事中，心無所樂。",
   "line": "0071a23",
   "section": "行腳",
   "cond": "見無樂著",
   "vow": "有為事中，心無所樂。"
  },
  {
   "n": 82,
   "text": "見歡樂人，當願眾生：常得安樂，樂供養佛。",
   "line": "0071a25",
   "section": "行腳",
   "cond": "見歡樂人",
   "vow": "常得安樂，樂供養佛。"
  },
  {
   "n": 83,
   "text": "見苦惱人，當願眾生：獲根本智，滅除眾苦。",
   "line": "0071a26",
   "section": "行腳",
   "cond": "見苦惱人",
   "vow": "獲根本智，滅除眾苦。"
  },
  {
   "n": 84,
   "text": "見無病人，當願眾生：入真實慧，永無病惱。",
   "line": "0071a27",
   "section": "行腳",
   "cond": "見無病人",
   "vow": "入真實慧，永無病惱。"
  },
  {
   "n": 85,
   "text": "見疾病人，當願眾生：知身空寂，離乖諍法。",
   "line": "0071a29",
   "section": "行腳",
   "cond": "見疾病人",
   "vow": "知身空寂，離乖諍法。"
  },
  {
   "n": 86,
   "text": "見端正人，當願眾生：於佛菩薩，常生淨信。",
   "line": "0071b01",
   "section": "行腳",
   "cond": "見端正人",
   "vow": "於佛菩薩，常生淨信。"
  },
  {
   "n": 87,
   "text": "見醜陋人，當願眾生：於不善事，不生樂著。",
   "line": "0071b02",
   "section": "行腳",
   "cond": "見醜陋人",
   "vow": "於不善事，不生樂著。"
  },
  {
   "n": 88,
   "text": "見報恩人，當願眾生：於佛菩薩，能知恩德。",
   "line": "0071b04",
   "section": "行腳",
   "cond": "見報恩人",
   "vow": "於佛菩薩，能知恩德。"
  },
  {
   "n": 89,
   "text": "見背恩人，當願眾生：於有惡人，不加其報。",
   "line": "0071b05",
   "section": "行腳",
   "cond": "見背恩人",
   "vow": "於有惡人，不加其報。"
  },
  {
   "n": 90,
   "text": "若見沙門，當願眾生：調柔寂靜，畢竟第一。",
   "line": "0071b06",
   "section": "行腳",
   "cond": "若見沙門",
   "vow": "調柔寂靜，畢竟第一。"
  },
  {
   "n": 91,
   "text": "見婆羅門，當願眾生：永持梵行，離一切惡。",
   "line": "0071b08",
   "section": "行腳",
   "cond": "見婆羅門",
   "vow": "永持梵行，離一切惡。"
  },
  {
   "n": 92,
   "text": "見苦行人，當願眾生：依於苦行，至究竟處。",
   "line": "0071b09",
   "section": "行腳",
   "cond": "見苦行人",
   "vow": "依於苦行，至究竟處。"
  },
  {
   "n": 93,
   "text": "見操行人，當願眾生：堅持志行，不捨佛道。",
   "line": "0071b10",
   "section": "行腳",
   "cond": "見操行人",
   "vow": "堅持志行，不捨佛道。"
  },
  {
   "n": 94,
   "text": "見著甲冑，當願眾生：常服善鎧，趣無師法。",
   "line": "0071b12",
   "section": "行腳",
   "cond": "見著甲冑",
   "vow": "常服善鎧，趣無師法。"
  },
  {
   "n": 95,
   "text": "見無鎧仗，當願眾生：永離一切，不善之業。",
   "line": "0071b13",
   "section": "行腳",
   "cond": "見無鎧仗",
   "vow": "永離一切，不善之業。"
  },
  {
   "n": 96,
   "text": "見論議人，當願眾生：於諸異論，悉能摧伏。",
   "line": "0071b14",
   "section": "行腳",
   "cond": "見論議人",
   "vow": "於諸異論，悉能摧伏。"
  },
  {
   "n": 97,
   "text": "見正命人，當願眾生：得清淨命，不矯威儀。",
   "line": "0071b16",
   "section": "行腳",
   "cond": "見正命人",
   "vow": "得清淨命，不矯威儀。"
  },
  {
   "n": 98,
   "text": "若見於王，當願眾生：得為法王，恒轉正法。",
   "line": "0071b17",
   "section": "行腳",
   "cond": "若見於王",
   "vow": "得為法王，恒轉正法。"
  },
  {
   "n": 99,
   "text": "若見王子，當願眾生：從法化生，而為佛子。",
   "line": "0071b18",
   "section": "行腳",
   "cond": "若見王子",
   "vow": "從法化生，而為佛子。"
  },
  {
   "n": 100,
   "text": "若見長者，當願眾生：善能明斷，不行惡法。",
   "line": "0071b20",
   "section": "行腳",
   "cond": "若見長者",
   "vow": "善能明斷，不行惡法。"
  },
  {
   "n": 101,
   "text": "若見大臣，當願眾生：恒守正念，習行眾善。",
   "line": "0071b21",
   "section": "行腳",
   "cond": "若見大臣",
   "vow": "恒守正念，習行眾善。"
  },
  {
   "n": 102,
   "text": "若見城廓，當願眾生：得堅固身，心無所屈。",
   "line": "0071b22",
   "section": "行腳",
   "cond": "若見城廓",
   "vow": "得堅固身，心無所屈。"
  },
  {
   "n": 103,
   "text": "若見王都，當願眾生：功德共聚，心恒喜樂。",
   "line": "0071b24",
   "section": "行腳",
   "cond": "若見王都",
   "vow": "功德共聚，心恒喜樂。"
  },
  {
   "n": 104,
   "text": "見處林藪，當願眾生：應為天人，之所歎仰。",
   "line": "0071b25",
   "section": "行腳",
   "cond": "見處林藪",
   "vow": "應為天人，之所歎仰。"
  },
  {
   "n": 105,
   "text": "入里乞食，當願眾生：入深法界，心無障礙。",
   "line": "0071b26",
   "section": "乞食",
   "cond": "入里乞食",
   "vow": "入深法界，心無障礙。"
  },
  {
   "n": 106,
   "text": "到人門戶，當願眾生：入於一切，佛法之門。",
   "line": "0071b28",
   "section": "乞食",
   "cond": "到人門戶",
   "vow": "入於一切，佛法之門。"
  },
  {
   "n": 107,
   "text": "入其家已，當願眾生：得入佛乘，三世平等。",
   "line": "0071b29",
   "section": "乞食",
   "cond": "入其家已",
   "vow": "得入佛乘，三世平等。"
  },
  {
   "n": 108,
   "text": "見不捨人，當願眾生：常不捨離，勝功德法。",
   "line": "0071c01",
   "section": "乞食",
   "cond": "見不捨人",
   "vow": "常不捨離，勝功德法。"
  },
  {
   "n": 109,
   "text": "見能捨人，當願眾生：永得捨離，三惡道苦。",
   "line": "0071c03",
   "section": "乞食",
   "cond": "見能捨人",
   "vow": "永得捨離，三惡道苦。"
  },
  {
   "n": 110,
   "text": "若見空鉢，當願眾生：其心清淨，空無煩惱。",
   "line": "0071c04",
   "section": "乞食",
   "cond": "若見空鉢",
   "vow": "其心清淨，空無煩惱。"
  },
  {
   "n": 111,
   "text": "若見滿鉢，當願眾生：具足成滿，一切善法。",
   "line": "0071c05",
   "section": "乞食",
   "cond": "若見滿鉢",
   "vow": "具足成滿，一切善法。"
  },
  {
   "n": 112,
   "text": "若得恭敬，當願眾生：恭敬修行，一切佛法。",
   "line": "0071c07",
   "section": "乞食",
   "cond": "若得恭敬",
   "vow": "恭敬修行，一切佛法。"
  },
  {
   "n": 113,
   "text": "不得恭敬，當願眾生：不行一切，不善之法。",
   "line": "0071c08",
   "section": "乞食",
   "cond": "不得恭敬",
   "vow": "不行一切，不善之法。"
  },
  {
   "n": 114,
   "text": "見慚恥人，當願眾生：具慚恥行，藏護諸根。",
   "line": "0071c09",
   "section": "乞食",
   "cond": "見慚恥人",
   "vow": "具慚恥行，藏護諸根。"
  },
  {
   "n": 115,
   "text": "見無慚恥，當願眾生：捨離無慚，住大慈道。",
   "line": "0071c11",
   "section": "乞食",
   "cond": "見無慚恥",
   "vow": "捨離無慚，住大慈道。"
  },
  {
   "n": 116,
   "text": "若得美食，當願眾生：滿足其願，心無羨欲。",
   "line": "0071c12",
   "section": "乞食",
   "cond": "若得美食",
   "vow": "滿足其願，心無羨欲。"
  },
  {
   "n": 117,
   "text": "得不美食，當願眾生：莫不獲得，諸三昧味。",
   "line": "0071c13",
   "section": "乞食",
   "cond": "得不美食",
   "vow": "莫不獲得，諸三昧味。"
  },
  {
   "n": 118,
   "text": "得柔軟食，當願眾生：大悲所熏，心意柔軟。",
   "line": "0071c15",
   "section": "乞食",
   "cond": "得柔軟食",
   "vow": "大悲所熏，心意柔軟。"
  },
  {
   "n": 119,
   "text": "得麁澁食，當願眾生：心無染著，絕世貪愛。",
   "line": "0071c16",
   "section": "乞食",
   "cond": "得麁澁食",
   "vow": "心無染著，絕世貪愛。"
  },
  {
   "n": 120,
   "text": "若飯食時，當願眾生：禪悅為食，法喜充滿。",
   "line": "0071c17",
   "section": "乞食",
   "cond": "若飯食時",
   "vow": "禪悅為食，法喜充滿。"
  },
  {
   "n": 121,
   "text": "若受味時，當願眾生：得佛上味，甘露滿足。",
   "line": "0071c19",
   "section": "乞食",
   "cond": "若受味時",
   "vow": "得佛上味，甘露滿足。"
  },
  {
   "n": 122,
   "text": "飯食已訖，當願眾生：所作皆辦，具諸佛法。",
   "line": "0071c20",
   "section": "乞食",
   "cond": "飯食已訖",
   "vow": "所作皆辦，具諸佛法。"
  },
  {
   "n": 123,
   "text": "若說法時，當願眾生：得無盡辯，廣宣法要。",
   "line": "0071c21",
   "section": "說法禮佛",
   "cond": "若說法時",
   "vow": "得無盡辯，廣宣法要。"
  },
  {
   "n": 124,
   "text": "從舍出時，當願眾生：深入佛智，永出三界。",
   "line": "0071c23",
   "section": "說法禮佛",
   "cond": "從舍出時",
   "vow": "深入佛智，永出三界。"
  },
  {
   "n": 125,
   "text": "若入水時，當願眾生：入一切智，知三世等。",
   "line": "0071c24",
   "section": "說法禮佛",
   "cond": "若入水時",
   "vow": "入一切智，知三世等。"
  },
  {
   "n": 126,
   "text": "洗浴身體，當願眾生：身心無垢，內外光潔。",
   "line": "0071c25",
   "section": "說法禮佛",
   "cond": "洗浴身體",
   "vow": "身心無垢，內外光潔。"
  },
  {
   "n": 127,
   "text": "盛暑炎毒，當願眾生：捨離眾惱，一切皆盡。",
   "line": "0071c27",
   "section": "說法禮佛",
   "cond": "盛暑炎毒",
   "vow": "捨離眾惱，一切皆盡。"
  },
  {
   "n": 128,
   "text": "暑退涼初，當願眾生：證無上法，究竟清涼。",
   "line": "0071c28",
   "section": "說法禮佛",
   "cond": "暑退涼初",
   "vow": "證無上法，究竟清涼。"
  },
  {
   "n": 129,
   "text": "諷誦經時，當願眾生：順佛所說，總持不忘。",
   "line": "0071c29",
   "section": "說法禮佛",
   "cond": "諷誦經時",
   "vow": "順佛所說，總持不忘。"
  },
  {
   "n": 130,
   "text": "若得見佛，當願眾生：得無礙眼，見一切佛。",
   "line": "0072a02",
   "section": "說法禮佛",
   "cond": "若得見佛",
   "vow": "得無礙眼，見一切佛。"
  },
  {
   "n": 131,
   "text": "諦觀佛時，當願眾生：皆如普賢，端正嚴好。",
   "line": "0072a03",
   "section": "說法禮佛",
   "cond": "諦觀佛時",
   "vow": "皆如普賢，端正嚴好。"
  },
  {
   "n": 132,
   "text": "見佛塔時，當願眾生：尊重如塔，受天人供。",
   "line": "0072a04",
   "section": "說法禮佛",
   "cond": "見佛塔時",
   "vow": "尊重如塔，受天人供。"
  },
  {
   "n": 133,
   "text": "敬心觀塔，當願眾生：諸天及人，所共瞻仰。",
   "line": "0072a06",
   "section": "說法禮佛",
   "cond": "敬心觀塔",
   "vow": "諸天及人，所共瞻仰。"
  },
  {
   "n": 134,
   "text": "頂禮於塔，當願眾生：一切天人，無能見頂。",
   "line": "0072a07",
   "section": "說法禮佛",
   "cond": "頂禮於塔",
   "vow": "一切天人，無能見頂。"
  },
  {
   "n": 135,
   "text": "右遶於塔，當願眾生：所行無逆，成一切智。",
   "line": "0072a08",
   "section": "說法禮佛",
   "cond": "右遶於塔",
   "vow": "所行無逆，成一切智。"
  },
  {
   "n": 136,
   "text": "遶塔三匝，當願眾生：勤求佛道，心無懈歇。",
   "line": "0072a10",
   "section": "說法禮佛",
   "cond": "遶塔三匝",
   "vow": "勤求佛道，心無懈歇。"
  },
  {
   "n": 137,
   "text": "讚佛功德，當願眾生：眾德悉具，稱歎無盡。",
   "line": "0072a11",
   "section": "說法禮佛",
   "cond": "讚佛功德",
   "vow": "眾德悉具，稱歎無盡。"
  },
  {
   "n": 138,
   "text": "讚佛相好，當願眾生：成就佛身，證無相法。",
   "line": "0072a12",
   "section": "說法禮佛",
   "cond": "讚佛相好",
   "vow": "成就佛身，證無相法。"
  },
  {
   "n": 139,
   "text": "若洗足時，當願眾生：具神足力，所行無礙。",
   "line": "0072a14",
   "section": "寢息",
   "cond": "若洗足時",
   "vow": "具神足力，所行無礙。",
