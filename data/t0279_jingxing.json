   "text": "若舉於足，當願眾生：出生死海，具眾善法。",
   "line": "0070b20",
   "section": "威儀",
   "cond": "若舉於足",
   "vow": "出生死海，具眾善法。"
  },
  {
   "n": 36,
   "text": "著下帬時，當願眾生：服諸善根，具足慚愧。",
   "line": "0070b21",
   "section": "威儀",
   "cond": "著下帬時",
   "vow": "服諸善根，具足慚愧。",
   "notes": [
    "帬【大】，裙【宋】【元】【明】【宮】"
   ]
  },
  {
   "n": 37,
   "text": "整衣束帶，當願眾生：檢束善根，不令散失。",
   "line": "0070b23",
   "section": "威儀",
   "cond": "整衣束帶",
   "vow": "檢束善根，不令散失。"
  },
  {
   "n": 38,
   "text": "若著上衣，當願眾生：獲勝善根，至法彼岸。",
   "line": "0070b24",
   "section": "威儀",
   "cond": "若著上衣",
   "vow": "獲勝善根，至法彼岸。"
  },
  {
   "n": 39,
   "text": "著僧伽梨，當願眾生：入第一位，得不動法。",
   "line": "0070b25",
   "section": "威儀",
   "cond": "著僧伽梨",
   "vow": "入第一位，得不動法。"
  },
  {
   "n": 40,
   "text": "手執楊枝，當願眾生：皆得妙法，究竟清淨。",
   "line": "0070b27",
   "section": "威儀",
   "cond": "手執楊枝",
   "vow": "皆得妙法，究竟清淨。"
  },
  {
   "n": 41,
   "text": "嚼楊枝時，當願眾生：其心調淨，噬諸煩惱。",
   "line": "0070b28",
   "section": "威儀",
   "cond": "嚼楊枝時",
   "vow": "其心調淨，噬諸煩惱。"
  },
  {
   "n": 42,
   "text": "大小便時，當願眾生：棄貪瞋癡，蠲除罪法。",
   "line": "0070b29",
   "section": "威儀",
   "cond": "大小便時",
   "vow": "棄貪瞋癡，蠲除罪法。"
  },
  {
   "n": 43,
   "text": "事訖就水，當願眾生：出世法中，速疾而往。",
   "line": "0070c02",
   "section": "威儀",
   "cond": "事訖就水",
   "vow": "出世法中，速疾而往。"
  },
  {
   "n": 44,
   "text": "洗滌形穢，當願眾生：清淨調柔，畢竟無垢。",
   "line": "0070c03",
   "section": "威儀",
   "cond": "洗滌形穢",
   "vow": "清淨調柔，畢竟無垢。"
  },
  {
   "n": 45,
   "text": "以水盥掌，當願眾生：得清淨手，受持佛法。",
   "line": "0070c04",
   "section": "威儀",
   "cond": "以水盥掌",
   "vow": "得清淨手，受持佛法。"
  },
  {
   "n": 46,
   "text": "以水洗面，當願眾生：得淨法門，永無垢染。",
   "line": "0070c06",
   "section": "威儀",
   "cond": "以水洗面",
   "vow": "得淨法門，永無垢染。"
  },
  {
   "n": 47,
   "text": "手執錫杖，當願眾生：設大施會，示如實道。",
